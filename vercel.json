{
  "rewrites": [
    { "source": "/C4Clinic/(.*)", "destination": "/index.html" },
    { "source": "/C4Clinic", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/C4Clinic/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/C4Clinic/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/C4Clinic/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
